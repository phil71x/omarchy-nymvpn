#!/usr/bin/env bash
# NymVPN tunnel status as one JSON line, with a toast on connect and on a real disconnect.
# Reads the last tunnel state from the nym-vpnd log (world-readable); never calls nym-vpnc.
#   nym-status [--no-notify]   --no-notify still records the status, so no stale toast later
#   status  up | busy | paused | down | unknown (no tunnel state in a readable log, or a state
#           this script does not know: one normal toast, the card keeps the last details)
#   reason  why the status is unknown, empty otherwise
#   state   raw nym-vpnd tunnel state; since, sinceEpoch: when it began (local time)
#   mode (wg | mix), entryIp, exitIp, entryCc, exitCc, entryUptime, exitUptime: route, only while connected
#   entryName, exitName, entryLoad, exitLoad, entryIpv6, exitIpv6: from nym-ctl's gateway cache,
#   empty without controls (load also empty once the cache is over an hour old);
#   an IPv6 is "None" when the gateway has none

LOG_DIR=${NYMVPN_LOG_DIR:-/var/log/nym-vpnd}
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/io.github.phil71x.nymvpn"
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/io.github.phil71x.nymvpn"
STATE_FILE="$STATE_DIR/last-status"
UNKNOWN_FILE="$STATE_DIR/unknown-notified"   # the unknown toast was sent for this spell

line="" readable=false
for log in "$LOG_DIR/nym-vpnd.log" "$LOG_DIR/nym-vpnd.old.log"; do
  [[ -r $log ]] || continue
  readable=true
  line=$(tac "$log" | grep -m1 'tunnel_state_machine: New tunnel state:')
  [[ -n $line ]] && break
done

state=${line#*New tunnel state: }
since="" since_epoch=""
if [[ -n $line ]]; then   # date -d "" would give today's midnight
  since=$(date -d "${line%% *}" +%H:%M 2>/dev/null)
  since_epoch=$(date -d "${line%% *}" +%s 2>/dev/null)
fi

# Route details for the status card (only meaningful while connected).
mode="" entry_ip="" exit_ip="" entry_cc="" exit_cc="" entry_uptime="" exit_uptime="" entry_load="" exit_load="" entry_ipv6="" exit_ipv6="" entry_name="" exit_name=""
# dVPN: "Connected wg to <ip>:<port> [<id>] → <ip>:<port> [<id>]"; Mixnet: "Connected mix to <ip> [<id>] → <ip> [<id>]".
if [[ $state =~ ^Connected\ ([a-z]+)\ to\ ([0-9.]+)[:\ ].*→\ ([0-9.]+)[:\ ] ]]; then
  mode=${BASH_REMATCH[1]} entry_ip=${BASH_REMATCH[2]} exit_ip=${BASH_REMATCH[3]}
  # The log calls a gateway's uptime its "performance".
  while read -r role cc uptime; do
    [[ $role == entry ]] && entry_cc=$cc entry_uptime=$uptime
    [[ $role == exit ]] && exit_cc=$cc exit_uptime=$uptime
  done < <(tac "$log" | grep -m2 -E 'Using (entry|exit) gateway:' |
           sed -E 's/.*Using (entry|exit) gateway: [^,]*, location: ([A-Z]+), performance: ([0-9]+%).*/\1 \2 \3/')
  # Gateway ids are in brackets on the Connected line; loads come from nym-ctl's cache.
  mapfile -t ids < <(grep -oE '\[[1-9A-HJ-NP-Za-km-z]{32,}\]' <<<"$state" | tr -d '[]')
  if [[ $mode == wg ]]; then
    entry_list="$CACHE_DIR/wg.json" exit_list="$CACHE_DIR/wg.json"
  else
    entry_list="$CACHE_DIR/mixnet-entry.json" exit_list="$CACHE_DIR/mixnet-exit.json"
  fi
  # gateway <list> <id>: load, ipv6 and name, separated by \x1f, for a gateway known to the cache. Names and
  # IPv6 rarely change; the load does, so it is dropped once the cache is over an hour old
  # (nym-ctl refreshes it hourly only while controls are enabled).
  gateway() {
    [[ -r $1 ]] || return 0
    local fresh=false
    [[ -n $(find "$1" -mmin -60) ]] && fresh=true
    jq -r --arg id "$2" --argjson fresh "$fresh" '
      if .servers[$id] then [(if $fresh then .loads[$id] // "" else "" end), (.ipv6[$id] // "None"), .servers[$id]] | join("\u001f")
      else empty end' "$1" 2>/dev/null
  }
  # A non-whitespace separator, so read keeps an empty load instead of shifting the fields.
  IFS=$'\x1f' read -r entry_load entry_ipv6 entry_name < <(gateway "$entry_list" "${ids[0]:-}")
  IFS=$'\x1f' read -r exit_load exit_ipv6 exit_name < <(gateway "$exit_list" "${ids[1]:-}")
fi

# Classes: up = tunnel up; busy = Connecting/Disconnecting; paused = offline (suspend, Wi-Fi lost)
# with auto-connect, nothing to leak and the daemon reconnects by itself; down = Disconnected,
# Error, Offline without auto-connect, daemon stopped; unknown = no state line (log missing,
# unreadable or reworded) or a state not listed here, so no false alarm.
reason=""
if ! systemctl is-active --quiet nym-vpnd; then
  status=down; state="nym-vpnd stopped"
else
  case $state in
    Connected*)                         status=up ;;
    Connecting* | Disconnecting*)       status=busy ;;
    "Offline, auto-connect"*)           status=paused ;;
    Disconnected* | Error* | Offline*)  status=down ;;
    "")                                 status=unknown; reason="No tunnel state in the NymVPN log"
                                        $readable || reason="Cannot read the NymVPN log" ;;
    *)                                  status=unknown; reason="Unknown NymVPN state: ${state%%,*}" ;;
  esac
fi

# Toast only on stable transitions; busy and unknown keep the previous status. Toasts are sent for
# up and down only: paused happens at every suspend and would toast several times a day.
# Unknown gets one normal toast per spell, not a critical one: the tunnel may be fine, but a
# drop would go unseen until the status is known again.
# The state file lives in XDG_RUNTIME_DIR, wiped at reboot, so the first run records a baseline silently.
# The bar runs one widget per monitor, so the lock keeps two of them from toasting the same change.
if [[ $status != busy ]]; then
  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/lock"
  flock 9
  prev=$(cat "$STATE_FILE" 2>/dev/null)
  if [[ $status == unknown ]]; then
    if [[ $1 != --no-notify && -n $prev && ! -e $UNKNOWN_FILE ]]; then
      notify-send "NymVPN status unknown" "$reason. A disconnect would not be detected."
    fi
    touch "$UNKNOWN_FILE"
  else
    if [[ $1 != --no-notify && -n $prev && $prev != "$status" ]]; then
      case $status in
        up)   notify-send "NymVPN connected" "Traffic protected since $since" ;;
        # No -a: Omarchy lets critical toasts from bare notify-send through Do Not Disturb and never expires them.
        down) notify-send -u critical "NymVPN disconnected" "Traffic NOT protected. Open NymVPN to reconnect." ;;
      esac
    fi
    echo "$status" > "$STATE_FILE"
    rm -f "$UNKNOWN_FILE"
  fi
fi

route=$(sed -E 's/ \[[^]]*\]//g; s/^Connected [a-z]+ to //' <<<"$state")
case $status in
  up)     tooltip="NymVPN: connected since $since"$'\n'"$route" ;;
  busy)   tooltip="NymVPN: ${state%%,*}…" ;;
  paused) tooltip="NymVPN: offline, will reconnect automatically" ;;
  down)   tooltip="NymVPN: DISCONNECTED since $since, not protected" ;;
  unknown) tooltip="NymVPN: $reason" ;;
esac

jq -nc --arg status "$status" --arg reason "$reason" --arg tooltip "$tooltip" \
  --arg state "$state" --arg since "$since" --arg sinceEpoch "$since_epoch" --arg mode "$mode" \
  --arg entryIp "$entry_ip" --arg exitIp "$exit_ip" --arg entryCc "$entry_cc" --arg exitCc "$exit_cc" \
  --arg entryUptime "$entry_uptime" --arg exitUptime "$exit_uptime" \
  --arg entryLoad "$entry_load" --arg exitLoad "$exit_load" \
  --arg entryIpv6 "$entry_ipv6" --arg exitIpv6 "$exit_ipv6" \
  --arg entryName "$entry_name" --arg exitName "$exit_name" \
  '{status: $status, reason: $reason, tooltip: $tooltip, state: $state, since: $since,
    sinceEpoch: $sinceEpoch, mode: $mode, entryIp: $entryIp, exitIp: $exitIp,
    entryCc: $entryCc, exitCc: $exitCc, entryUptime: $entryUptime, exitUptime: $exitUptime,
    entryLoad: $entryLoad, exitLoad: $exitLoad, entryIpv6: $entryIpv6, exitIpv6: $exitIpv6,
    entryName: $entryName, exitName: $exitName}'
