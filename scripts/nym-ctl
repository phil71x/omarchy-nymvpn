#!/usr/bin/env bash
# Control nym-vpnd from the status card through nym-vpnc.
#   nym-ctl authorized                {"authorized": true} if controls work (no nym-vpnc call)
#   nym-ctl config                    current mode, gateway constraints and countries (JSON)
#   nym-ctl countries                 gateway countries for the current mode (JSON, cached 1 h)
#   nym-ctl connect | disconnect
#   nym-ctl mode dvpn|mixnet          reconnects if connected
#   nym-ctl entry|exit auto|random|CC reconnects if connected
# Each nym-vpnc call takes ~6 s, so callers run this asynchronously; a run still going after
# NYMVPN_TIMEOUT seconds (60) is stopped and fails with exit code 124 (137 if it had to be killed).
# nym-vpnc is never called unless polkit already allows it: otherwise this prints
# {"error": "not-authorized" | "nym-vpnc-missing", "message": …} and exits 3.

set -o pipefail
POLKIT_ACTION=com.nymvpn.vpnd.unix-access
LOG_DIR=${NYMVPN_LOG_DIR:-/var/log/nym-vpnd}
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/io.github.phil71x.nymvpn"
ISO=/usr/share/iso-codes/json/iso_3166-1.json
TIMEOUT=${NYMVPN_TIMEOUT:-60}
[[ $TIMEOUT =~ ^[1-9][0-9]*$ ]] || TIMEOUT=60   # whole seconds: also used in bash arithmetic

fail() {
  jq -nc --arg error "$1" --arg message "$2" '{error: $error, message: $message}'
  exit 3
}

usage() {
  sed -n '2,12s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

# Without -u, pkcheck never prompts: exit 0 means allowed, anything else means a password would be asked.
require_authorized() {
  command -v nym-vpnc >/dev/null || fail nym-vpnc-missing "nym-vpnc is not installed"
  pkcheck -a "$POLKIT_ACTION" -p $$ >/dev/null 2>&1 ||
    fail not-authorized "polkit does not allow $POLKIT_ACTION without a password"
}

vpnc() { nym-vpnc --table-style blank "$@"; }

connected() {
  local log line=""
  for log in "$LOG_DIR/nym-vpnd.log" "$LOG_DIR/nym-vpnd.old.log"; do
    [[ -r $log ]] || continue
    line=$(tac "$log" | grep -m1 'New tunnel state:')
    [[ -n $line ]] && break
  done
  [[ $line == *"New tunnel state: Connected"* ]]
}

two_hop() {
  vpnc tunnel get | awk -F': ' '/^Two-hop:/ {print $2}'
}

# Gateway list type for one side, given the two-hop setting (on = dVPN).
list_type() {
  [[ $1 == on ]] && echo wg || echo "mixnet-$2"
}

# {servers: {id: name}, loads: {id: Low|Medium|High}, ipv6: {id: exit IPv6, when it has one},
#  countries: [{code, name, count}]},
# cached per list type for an hour, since server load changes; nym-status reads the loads.
# Written through a temporary file named after the deadline run, which removes any left behind.
countries_for() {
  local type=$1 cache="$CACHE_DIR/$1.json"
  mkdir -p "$CACHE_DIR"
  if [[ ! -s $cache || -n $(find "$cache" -mmin +60) ]]; then
    nym-vpnc --table-style markdown gateway list "$type" |
      # Server names may contain "|", so anchor on the performance column "(load: …)".
      sed -nE 's/^\| ([1-9A-HJ-NP-Za-km-z]{32,}) +\| (.*\S) +\| [^|]*\[([A-Z]{2})\] +\| [^|]*\(load: ([A-Za-z]+)[^|]*\| [^|]*\| ([0-9a-f:]*) *\|.*/\1\t\3\t\2\t\4\t\5/p' |
      jq -R -s --slurpfile iso "$ISO" '
        ($iso[0]["3166-1"] | map({key: .alpha_2, value: (.common_name // .name)}) | from_entries) as $names
        | split("\n") | map(select(length > 0) | split("\t") | {id: .[0], code: .[1], name: .[2], load: .[3], ipv6: .[4]})
        | {servers: map({key: .id, value: .name}) | from_entries,
           loads: map({key: .id, value: .load}) | from_entries,
           ipv6: map(select(.ipv6 != "") | {key: .id, value: .ipv6}) | from_entries,
           countries: (group_by(.code) | map({code: .[0].code, name: ($names[.[0].code] // (if .[0].code == "XK" then "Kosovo" else .[0].code end)), count: length})
                       | sort_by(.name))}' > "$cache.$NYMCTL_DEADLINE" && mv "$cache.$NYMCTL_DEADLINE" "$cache"
  fi
  # A failed fetch keeps a stale cache; with none at all, fail rather than show no countries.
  [[ -s $cache ]] || { echo "Could not get the NymVPN $type gateway list" >&2; return 1; }
  cat "$cache"
}

# "Entry point: Country { two_letter_iso_country_code: "CH" }" -> {kind, value}
point() {
  local line=$1
  case $line in
    *two_letter_iso_country_code*) jq -nc --arg v "$(grep -oE '"[A-Z]{2}"' <<<"$line" | tr -d '"')" '{kind: "country", value: $v}' ;;
    *NodeIdentity*)                jq -nc --arg v "$(grep -oE 'key: "[^"]+"' <<<"$line" | cut -d'"' -f2)" '{kind: "server", value: $v}' ;;
    *Random*)                      jq -nc '{kind: "random", value: ""}' ;;
    *)                             jq -nc '{kind: "auto", value: ""}' ;;
  esac
}

reconnect_if_connected() {
  if connected; then vpnc reconnect >/dev/null; fi
}

# One deadline for the whole run, pkcheck and every nym-vpnc call included, so a hung daemon
# cannot lock the card's controls: timeout terminates the run's process group (-k: kills the
# run if it ignores that), then whatever survives in the group, such as a nym-vpnc ignoring SIGTERM.
if [[ -z ${NYMCTL_DEADLINE:-} ]]; then
  code=0
  NYMCTL_DEADLINE=$$ timeout -k 5 "$TIMEOUT" "$BASH" "$0" "$@" &
  run=$!
  # Stopped from outside (shell restart, plugin disabled): the run in its own group stops too.
  trap 'kill -KILL -- "-$run" 2>/dev/null; rm -f "$CACHE_DIR"/*.json."$$"; exit 143' TERM INT HUP
  wait "$run" || code=$?
  # 137 is a timeout only once the deadline passed: nym-vpnc can also be killed by something else.
  if (( code == 124 || (code == 137 && SECONDS >= TIMEOUT) )); then
    kill -KILL -- "-$run" 2>/dev/null   # timeout leads the run's process group
    echo "NymVPN did not answer within $TIMEOUT s" >&2
  fi
  rm -f "$CACHE_DIR"/*.json."$$"   # left by a gateway list that failed or was cut off
  exit "$code"
fi

case $1 in
  authorized | config | countries | connect | disconnect | mode | entry | exit) require_authorized ;;
  *) usage ;;
esac

case $1 in
  authorized) jq -nc '{authorized: true}' ;;
  config)
    hop=$(two_hop)
    gw=$(vpnc gateway get)
    entry=$(point "$(grep '^Entry point:' <<<"$gw")")
    exit_=$(point "$(grep '^Exit point:' <<<"$gw")")
    # Name specific servers from the cached gateway list.
    le=$(countries_for "$(list_type "$hop" entry)") || exit 1
    lx=$(countries_for "$(list_type "$hop" exit)") || exit 1
    jq -nc --arg hop "$hop" --argjson entry "$entry" --argjson exit "$exit_" --argjson le "$le" --argjson lx "$lx" '
      {mode: (if $hop == "on" then "dvpn" else "mixnet" end),
       entry: ($entry + {name: ($le.servers[$entry.value] // "")}),
       exit: ($exit + {name: ($lx.servers[$exit.value] // "")}),
       countries: {entry: $le.countries, exit: $lx.countries}}'
    ;;
  countries)
    hop=$(two_hop)
    entry=$(countries_for "$(list_type "$hop" entry)") || exit 1
    exit_=$(countries_for "$(list_type "$hop" exit)") || exit 1
    jq -nc --argjson e "$entry" --argjson x "$exit_" '{entry: $e.countries, exit: $x.countries}'
    ;;
  connect)    vpnc connect ;;
  disconnect) vpnc disconnect ;;
  mode)
    case $2 in
      dvpn)   vpnc tunnel set --two-hop on ;;
      mixnet) vpnc tunnel set --two-hop off ;;
      *) echo "usage: nym-ctl mode dvpn|mixnet" >&2; exit 2 ;;
    esac && reconnect_if_connected
    ;;
  entry | exit)
    side=$1
    case $2 in
      auto)          vpnc gateway set "--$side-auto-exclude-jurisdiction" off ;;
      random)        vpnc gateway set "--$side-random" ;;
      [A-Z][A-Z])    vpnc gateway set "--$side-country" "$2" ;;
      *) echo "usage: nym-ctl $side auto|random|CC" >&2; exit 2 ;;
    esac && reconnect_if_connected
    ;;
esac
