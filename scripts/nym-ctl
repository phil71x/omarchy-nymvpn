#!/usr/bin/env bash
# Control nym-vpnd from the status card through nym-vpnc.
#   nym-ctl authorized                {"authorized": true} if controls work (no nym-vpnc call)
#   nym-ctl config                    current mode, gateway constraints and countries (JSON)
#   nym-ctl connect | disconnect
#   nym-ctl mode dvpn|mixnet          reconnects if connected
#   nym-ctl entry|exit auto|random|CC reconnects if connected
# Each nym-vpnc call takes ~6 s, so callers run this asynchronously; a run still going after
# NYMVPN_TIMEOUT seconds (60) is stopped and fails with exit code 124 (137 if it had to be killed).
# nym-vpnc is never called unless polkit already allows it: otherwise this prints
# {"error": "not-authorized" | "nym-vpnc-missing", "message": …} and exits 3.

set -o pipefail
# ID, ACTION (the polkit action) and STATE_DIR, which keeps the last jurisdiction exclusion seen
# per side for Auto: the daemon forgets it once a country is chosen.
# shellcheck source-path=SCRIPTDIR source=controls.sh
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/controls.sh"
LOG_DIR=${NYMVPN_LOG_DIR:-/var/log/nym-vpnd}
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/$ID"
ISO=/usr/share/iso-codes/json/iso_3166-1.json
TIMEOUT=${NYMVPN_TIMEOUT:-60}
[[ $TIMEOUT =~ ^[1-9][0-9]*$ ]] || TIMEOUT=60   # whole seconds: also used in bash arithmetic

fail() {
  jq -nc --arg error "$1" --arg message "$2" '{error: $error, message: $message}'
  exit 3
}

usage() {
  sed -n '2,11s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

# Without -u, pkcheck never prompts: exit 0 means allowed, anything else means a password would be asked.
require_authorized() {
  command -v nym-vpnc >/dev/null || fail nym-vpnc-missing "nym-vpnc is not installed"
  pkcheck -a "$ACTION" -p $$ >/dev/null 2>&1 ||
    fail not-authorized "polkit does not allow $ACTION without a password"
}

vpnc() { nym-vpnc --table-style blank "$@"; }

connected() {
  local log line=""
  for log in "$LOG_DIR/nym-vpnd.log" "$LOG_DIR/nym-vpnd.old.log"; do
    [[ -r $log ]] || continue
    line=$(tac "$log" | grep -m1 'New tunnel state:')
    [[ -n $line ]] && break
  done
  [[ $line == *"New tunnel state: Connected"* ]]
}

# on (dVPN) or off (Mixnet); fails on a failed call or a missing or reworded line, never guesses Mixnet.
two_hop() {
  local hop
  hop=$(vpnc tunnel get | awk -F': ' '/^Two-hop:/ {print $2}') && [[ $hop == on || $hop == off ]] ||
    { echo "No two-hop setting in the nym-vpnc output" >&2; return 1; }
  echo "$hop"
}

# Gateway list type for one side, given the two-hop setting (on = dVPN).
list_type() {
  [[ $1 == on ]] && echo wg || echo "mixnet-$2"
}

# countries_for <type>: fills $CACHE_DIR/<type>.json, read by config and nym-status:
# {servers: {id: name}, loads: {id: Low|Medium|High}, ipv6: {id: exit IPv6, when it has one},
#  countries: [{code, name, count}]},
# cached per list type for an hour, since server load changes, and fetched again sooner when the
# cache has no countries (as 1.0.1 could write); nym-status reads the loads.
# Written through a temporary file named after the deadline run, which removes any left behind.
countries_for() {
  local type=$1 cache="$CACHE_DIR/$1.json"
  mkdir -p "$CACHE_DIR"
  # Fresh: under an hour old, with countries. A successful read checks one file, once.
  [[ -s $cache && -z $(find "$cache" -mmin +60) ]] && has_countries "$cache" && return 0
  nym-vpnc --table-style markdown gateway list "$type" |
    # Server names may contain "|", so anchor on the performance column "(load: …)".
    sed -nE 's/^\| ([1-9A-HJ-NP-Za-km-z]{32,}) +\| (.*\S) +\| [^|]*\[([A-Z]{2})\] +\| [^|]*\(load: ([A-Za-z]+)[^|]*\| [^|]*\| ([0-9a-f:]*) *\|.*/\1\t\3\t\2\t\4\t\5/p' |
    jq -R -s --slurpfile iso "$ISO" '
      ($iso[0]["3166-1"] | map({key: .alpha_2, value: (.common_name // .name)}) | from_entries) as $names
      | split("\n") | map(select(length > 0) | split("\t") | {id: .[0], code: .[1], name: .[2], load: .[3], ipv6: .[4]})
      | {servers: map({key: .id, value: .name}) | from_entries,
         loads: map({key: .id, value: .load}) | from_entries,
         ipv6: map(select(.ipv6 != "") | {key: .id, value: .ipv6}) | from_entries,
         countries: (group_by(.code) | map({code: .[0].code, name: ($names[.[0].code] // (if .[0].code == "XK" then "Kosovo" else .[0].code end)), count: length})
                     | sort_by(.name))}' > "$cache.$NYMCTL_DEADLINE" &&
    has_countries "$cache.$NYMCTL_DEADLINE" && mv "$cache.$NYMCTL_DEADLINE" "$cache" && return 0
  # A failed or empty fetch keeps a stale cache; with none at all, fail rather than show no countries.
  has_countries "$cache"
}

has_countries() { jq -e '.countries | length > 0' "$1" >/dev/null 2>&1; }

# "Entry point: Country { two_letter_iso_country_code: "CH" }" -> {kind, value}
# "Entry point: Auto { exclude_user_country: true }" -> {kind: "auto", value: "", exclude: "on"}
# The exit's one switch, --exit-auto-exclude-jurisdiction, drives both of its exclude_* flags.
# A constraint it does not know is {kind: "other", name: <its text>}, shown as is, never as Auto.
point() {
  local line=$1
  case $line in
    *two_letter_iso_country_code*) jq -nc --arg v "$(grep -oE '"[A-Z]{2}"' <<<"$line" | tr -d '"')" '{kind: "country", value: $v}' ;;
    *NodeIdentity*)                jq -nc --arg v "$(grep -oE 'key: "[^"]+"' <<<"$line" | cut -d'"' -f2)" '{kind: "server", value: $v}' ;;
    *": Random"*)                  jq -nc '{kind: "random", value: ""}' ;;
    *": Auto" | *": Auto "*)       local x=off
                                   [[ $line == *"exclude_user_country: true"* || $line == *"exclude_entry_point_country: true"* ]] && x=on
                                   jq -nc --arg x "$x" '{kind: "auto", value: "", exclude: $x}' ;;
    "")                            echo "No gateway constraint in the nym-vpnc output" >&2; return 1 ;;
    *)                             jq -nc --arg n "${line#*: }" '{kind: "other", value: "", name: $n}' ;;
  esac
}

# remember_exclusion <side> <point JSON>: keeps the exclusion of an Auto point for `<side> auto`.
remember_exclusion() {
  local x
  x=$(jq -r 'select(.kind == "auto") | .exclude' <<<"$2")
  [[ -n $x ]] || return 0
  # Replaced at once, so an `<side> auto` running meanwhile never reads an empty file.
  mkdir -p "$STATE_DIR" && printf '%s\n' "$x" > "$STATE_DIR/$1-auto-exclude.$NYMCTL_DEADLINE" &&
    mv "$STATE_DIR/$1-auto-exclude.$NYMCTL_DEADLINE" "$STATE_DIR/$1-auto-exclude"
}

reconnect_if_connected() {
  if connected; then vpnc reconnect >/dev/null; fi
}

# One deadline for the whole run, pkcheck and every nym-vpnc call included, so a hung daemon
# cannot lock the card's controls: timeout terminates the run's process group (-k: kills the
# run if it ignores that), then whatever survives in the group, such as a nym-vpnc ignoring SIGTERM.
if [[ -z ${NYMCTL_DEADLINE:-} ]]; then
  code=0
  NYMCTL_DEADLINE=$$ timeout -k 5 "$TIMEOUT" "$BASH" "$0" "$@" &
  run=$!
  # Stopped from outside (shell restart, plugin disabled): the run in its own group stops too.
  trap 'kill -KILL -- "-$run" 2>/dev/null; rm -f "$CACHE_DIR"/*.json."$$" "$STATE_DIR"/*."$$"; exit 143' TERM INT HUP
  wait "$run" || code=$?
  # 137 is a timeout only once the deadline passed: nym-vpnc can also be killed by something else.
  if (( code == 124 || (code == 137 && SECONDS >= TIMEOUT) )); then
    kill -KILL -- "-$run" 2>/dev/null   # timeout leads the run's process group
    echo "NymVPN did not answer within $TIMEOUT s" >&2
  fi
  rm -f "$CACHE_DIR"/*.json."$$" "$STATE_DIR"/*."$$"   # left by a run that failed or was cut off
  exit "$code"
fi

case $1 in
  authorized | config | connect | disconnect | mode | entry | exit) require_authorized ;;
  *) usage ;;
esac

case $1 in
  authorized) jq -nc '{authorized: true}' ;;
  config)
    hop=$(two_hop) || exit 1
    gw=$(vpnc gateway get) || exit 1
    entry=$(point "$(grep '^Entry point:' <<<"$gw")") || exit 1
    exit_=$(point "$(grep '^Exit point:' <<<"$gw")") || exit 1
    remember_exclusion entry "$entry"; remember_exclusion exit "$exit_"
    # Name specific servers from the cached gateway list.
    # The lists are read from the cache files: as arguments, a long list would exceed the 128 KiB limit.
    # A side without a list has null countries, and the reason goes out (listError); with no list
    # at all, countries is null: the mode and the choices still go out, so the card can change
    # the mode and never offers only Auto and Random.
    type_entry=$(list_type "$hop" entry) type_exit=$(list_type "$hop" exit)
    le="$CACHE_DIR/$type_entry.json" lx="$CACHE_DIR/$type_exit.json" missing=()
    countries_for "$type_entry" || { missing+=("$type_entry"); le=/dev/null; }
    if [[ $type_exit == "$type_entry" ]]; then lx=$le   # dVPN: one list for both sides
    elif ! countries_for "$type_exit"; then missing+=("$type_exit"); lx=/dev/null; fi
    case ${#missing[@]} in
      0) list_error="" ;;
      1) list_error="Could not get the NymVPN ${missing[0]} gateway list" ;;
      *) list_error="Could not get the NymVPN ${missing[0]} and ${missing[1]} gateway lists" ;;
    esac
    jq -nc --arg hop "$hop" --argjson entry "$entry" --argjson exit "$exit_" --arg err "$list_error" \
      --slurpfile le "$le" --slurpfile lx "$lx" '
      {mode: (if $hop == "on" then "dvpn" else "mixnet" end),
       entry: ($entry + {name: ($le[0].servers[$entry.value] // $entry.name // "")}),
       exit: ($exit + {name: ($lx[0].servers[$exit.value] // $exit.name // "")}),
       countries: ({entry: $le[0].countries, exit: $lx[0].countries} | if .entry == null and .exit == null then null else . end)}
      + (if $err == "" then {} else {listError: $err} end)'
    ;;
  connect)    vpnc connect ;;
  disconnect) vpnc disconnect ;;
  mode)
    case $2 in
      dvpn)   vpnc tunnel set --two-hop on ;;
      mixnet) vpnc tunnel set --two-hop off ;;
      *) echo "usage: nym-ctl mode dvpn|mixnet" >&2; exit 2 ;;
    esac && reconnect_if_connected
    ;;
  entry | exit)
    side=$1
    case $2 in
      auto)          exclude=$(cat "$STATE_DIR/$side-auto-exclude" 2>/dev/null)
                     [[ $exclude == on ]] || exclude=off   # never seen: NymVPN's default
                     vpnc gateway set "--$side-auto-exclude-jurisdiction" "$exclude" ;;
      random)        vpnc gateway set "--$side-random" ;;
      [A-Z][A-Z])    vpnc gateway set "--$side-country" "$2" ;;
      *) echo "usage: nym-ctl $side auto|random|CC" >&2; exit 2 ;;
    esac && reconnect_if_connected
    ;;
esac
