#!/usr/bin/env bash
# Disable the NymVPN controls of the status card: undo enable-controls, so the NymVPN
# daemon asks for a password again. Opened from the card in Omarchy's floating
# terminal; explains every change and asks before running sudo.

set -euo pipefail

# shellcheck source-path=SCRIPTDIR source=controls.sh
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/controls.sh"

cat <<EOF
Disable NymVPN controls

The status card goes back to read-only, and the NymVPN daemon asks for your
password again. Two changes, made with sudo:

  1. Remove the polkit rule $RULE_DST.
  2. Remove you ($USER) from the group $GROUP, if Enable controls added you.

EOF

if ! gum confirm "Disable controls?"; then
  echo "Nothing changed."
  exit 0
fi

sudo rm -f "$RULE_DST"
# No marker: enabled by 1.0.1 or earlier, or already a member before.
if in_group; then
  if [[ -e $MARKER ]] ||
     gum confirm --default=false "Enable controls may not have added you to $GROUP. Remove you from it?"; then
    sudo gpasswd -d "$USER" "$GROUP"
  else
    echo "Kept you in $GROUP."
  fi
fi
rm -f "$MARKER"

sleep 1
if pkcheck -a "$ACTION" -p $$ >/dev/null 2>&1; then
  echo "polkit still allows NymVPN without a password: another rule grants it."
  exit 1
else
  echo "Controls disabled."
fi
